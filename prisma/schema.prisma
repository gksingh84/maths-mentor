generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SuperAdmin {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  secretKeyHash String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Teacher {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  passwordHash    String
  school          String?
  subject         String?
  phone           String?
  apiKey          String?
  zoomAccessToken    String?
  zoomRefreshToken   String?
  zoomTokenExpiresAt DateTime?
  zoomEmail          String?
  zoomAccountId      String?
  active          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  students        Student[]
  quizzes         Quiz[]
  worksheetPapers WorksheetPaper[]
  chatMessages    ChatMessage[]
  calendarEvents  CalendarEvent[]
  attendances     StudentAttendance[]
  fees            StudentFee[]
  scoreRecords    StudentScoreRecord[]
  liveClasses     LiveClass[]
}

model Student {
  id                   String                @id @default(cuid())
  name                 String
  grade                String?               @default("Grade 6")
  passkey              String?
  passkeyHash          String
  passkeyLookup        String                @unique
  parentPhone          String?
  parentName           String?
  active               Boolean               @default(true)
  teacherId            String?
  teacher              Teacher?              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  joiningDate          DateTime?             @default(now())
  createdAt            DateTime              @default(now())
  attempts             Attempt[]
  worksheetSubmissions WorksheetSubmission[]
  chatMessages         ChatMessage[]
  attendances          StudentAttendance[]
  fees                 StudentFee[]
  scoreRecords         StudentScoreRecord[]
  liveAttendances      LiveClassAttendance[]
}

model Quiz {
  id                       String     @id @default(cuid())
  title                    String
  grade                    String?
  mode                     QuizMode
  status                   QuizStatus @default(DRAFT)
  timeLimitSeconds         Int?
  showResults              Boolean    @default(true)
  currentQuestionIndex     Int        @default(0)
  currentAnswerRevealed    Boolean    @default(false)
  teacherId                String?
  teacher                  Teacher?   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  questions                Question[]
  attempts                 Attempt[]
}

model Question {
  id        String   @id @default(cuid())
  quizId    String
  position  Int
  prompt    String
  marks     Int      @default(1)
  imageUrl  String?
  type      String   @default("MCQ")
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   Option[]
  answers   Answer[]
  @@unique([quizId, position])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  position   Int
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]
  @@unique([questionId, position])
}

model Attempt {
  id          String        @id @default(cuid())
  quizId      String
  studentId   String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadlineAt  DateTime?
  submittedAt DateTime?
  score       Int?
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     Answer[]
  @@unique([quizId, studentId])
}

model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String
  updatedAt  DateTime @updatedAt
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option    Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  @@unique([attemptId, questionId])
}

enum QuizMode {
  LIVE
  SELF_PACED
}

enum QuizStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model WorksheetPaper {
  id          String                @id @default(cuid())
  title       String
  subject     String?
  grade       String?
  totalMarks  Int                   @default(100)
  content     String
  status      WorksheetStatus       @default(PUBLISHED)
  teacherId   String?
  teacher     Teacher?              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  submissions WorksheetSubmission[]
}

model WorksheetSubmission {
  id               String           @id @default(cuid())
  paperId          String
  studentId        String
  images           String           @default("[]")
  score            Int?
  remarks          String?
  aiDraftScore     Int?
  aiDraftRemarks   String?
  aiDraftBreakdown String?
  aiStatus         String?          @default("IDLE")
  status           SubmissionStatus @default(SUBMITTED)
  submittedAt      DateTime         @default(now())
  gradedAt         DateTime?
  paper            WorksheetPaper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
}

enum WorksheetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

model StudyMaterial {
  id          String         @id @default(cuid())
  title       String
  description String?
  content     String?
  grade       String
  subject     String         @default("Mathematics")
  mediaType   StudyMediaType @default(ARTICLE)
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  videoUrl    String?
  coverImage  String?
  readTime    String?
  authorName  String         @default("EduAshram")
  status      MaterialStatus @default(PUBLISHED)
  views       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum StudyMediaType {
  ARTICLE
  PDF
  VIDEO
  PRESENTATION
  IMAGE
  WORKSHEET
}

enum MaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ChatMessage {
  id         String   @id @default(cuid())
  teacherId  String
  studentId  String?
  senderId   String
  senderName String
  senderRole String   // 'teacher' | 'student' | 'admin' | 'superadmin'
  channel    String   @default("everyone") // 'everyone' | 'direct'
  content    String
  createdAt  DateTime @default(now())

  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId, channel, createdAt])
  @@index([teacherId, studentId, channel, createdAt])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String?
  date        String   // "YYYY-MM-DD"
  time        String?  // Optional time string like "10:00 AM"
  type        String   @default("event") // "event" | "reminder" | "quiz" | "test" | "assignment" | "holiday"
  color       String?  @default("#0284c7")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, date])
}

model StudentAttendance {
  id           String   @id @default(cuid())
  studentId    String
  teacherId    String?
  date         String   // "YYYY-MM-DD"
  status       String   @default("PRESENT") // "PRESENT" | "ABSENT" | "LATE" | "EXCUSED"
  remarks      String?
  academicYear String   // e.g. "2026-2027" (April to March)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([studentId, academicYear])
  @@index([teacherId, date])
}

model StudentFee {
  id           String    @id @default(cuid())
  studentId    String
  teacherId    String?
  academicYear String    // "2026-2027"
  month        String    // "April", "May", "June", ... "March"
  amountDue    Float     @default(0)
  amountPaid   Float     @default(0)
  status       String    @default("PENDING") // "PAID" | "PENDING" | "PARTIAL" | "OVERDUE"
  paidAt       DateTime?
  paymentMode  String?   // "CASH" | "UPI" | "BANK_TRANSFER" | "CHEQUE" | "OTHER"
  receiptNo    String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYear, month])
  @@index([studentId, academicYear])
  @@index([teacherId, academicYear, month])
}

model StudentScoreRecord {
  id           String   @id @default(cuid())
  studentId    String
  teacherId    String?
  title        String   // Quiz or Question Paper Title
  itemType     String   // "QUIZ" | "QUESTION_PAPER"
  score        Float?
  totalMarks   Float    @default(0)
  percentage   Float?
  grade        String?
  subject      String?  @default("Mathematics")
  academicYear String   // "2026-2027" (April to March)
  completedAt  DateTime @default(now())
  remarks      String?
  quizId       String?  // Original quiz ID (NO cascade constraint, keeps record even if deleted)
  paperId      String?  // Original paper ID (NO cascade constraint, keeps record even if deleted)
  createdAt    DateTime @default(now())

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentId, academicYear])
  @@index([teacherId, academicYear])
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model LiveClass {
  id                  String                @id @default(cuid())
  title               String
  description         String?
  grade               String?               @default("Grade 6")
  subject             String                @default("Mathematics")
  zoomMeetingId       String
  zoomMeetingPasscode String?
  zoomStartUrl        String?               @db.Text
  zoomJoinUrl         String?               @db.Text
  startTime           DateTime
  durationMinutes     Int                   @default(60)
  status              LiveClassStatus       @default(SCHEDULED)
  recordingUrl        String?
  teacherId           String
  teacher             Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  attendances         LiveClassAttendance[]

  @@index([teacherId, status])
  @@index([grade, status])
  @@index([startTime])
}

model LiveClassAttendance {
  id              String    @id @default(cuid())
  liveClassId     String
  studentId       String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int       @default(0)

  liveClass       LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([liveClassId])
  @@index([studentId])
}



